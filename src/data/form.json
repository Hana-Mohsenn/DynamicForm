{
  "title": "Create Account",
  "description": "Fill in your information to register",
  "fields": [
    {
      "name": "fullName",
      "label": "Full Name",
      "type": "text",
      "placeholder": "Enter your full name",
      "required": true
    },
    {
      "name": "email",
      "label": "Email Address",
      "type": "email",
      "placeholder": "Enter your email",
      "required": true
    },
    {
      "name": "phone",
      "label": "Phone Number",
      "type": "tel",
      "placeholder": "Enter your phone number",
      "required": true
    },
    {
      "name": "password",
      "label": "Password",
      "type": "password",
      "placeholder": "Enter your password",
      "required": true
    },
    {
      "name": "confirmPassword",
      "label": "Confirm Password",
      "type": "password",
      "placeholder": "Confirm your password",
      "required": true
    },
    {
      "name": "gender",
      "label": "Gender",
      "type": "select",
      "required": true,
      "options": ["Male", "Female"]
    },
    {
      "name": "terms",
      "label": "I agree to the Terms and Conditions",
      "type": "checkbox",
      "required": true
    }
  ]
}
